VERDICT_RE = re.compile(r"\b(PASS|FAIL|BLOCKED[A-Z0-9_-]*|PARTIAL)\b")
VERDICT_KEY_RE = re.compile(r"verdict\s*:\s*(\S.*)", re.IGNORECASE)
RUN_RE = re.compile(r"([0-9]{9,11})-([0-9]{9})")  # SATS_RUN=$(date +%s-%N), the launch time
STEPS = ("producer", "review", "retry")
# lane.log step lines: "review start ...", "review exit 0 ...", and a repair loop's "repair r2 review exit 0 ..."
# or "r2 review exit 0 ...". Notes such as "review-noscan superseded ..." or "ACCEPT r2" are not step lines.
STEP_LINE_RE = re.compile(r"\s*(?:(?:repair\s+)?r[0-9]+\s+)?(producer|review|retry)\s+(?:start|exit\s+(-?[0-9]{1,4}))\b",
                          re.IGNORECASE)
# re.ASCII: \b sees only [A-Za-z0-9_] as word characters, as LC_ALL=C grep does in the loops' verdict().
REVIEW_VERDICT_RE = re.compile(r"^(ACCEPT|REQUEST_CHANGES)\b", re.ASCII)
ROUND_RE = re.compile(r"[.-]r([0-9]+)\.md$", re.IGNORECASE)  # REVIEW-SOL.r2.md, REVIEW-SOL-R2.md
LANE_STEP_RE = re.compile(r"-(review|retry)$", re.IGNORECASE)
RETRY_DELAYS = (0, 5, 20)
# HTTP rejection evidence is a projection, never raw response/request text.
HTTP_ERROR_BODY_LIMIT = 8192
