def write_private(path, data):
    tmp = path.with_name("%s.tmp.%d" % (path.name, os.getpid()))
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "w") as stream:
        os.fchmod(stream.fileno(), 0o600)
        json.dump(data, stream, sort_keys=True, separators=(",", ":"))
        stream.flush()
        os.fsync(stream.fileno())
    os.replace(tmp, path)
    directory_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)


def append(path, line):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "a", encoding="utf-8") as stream:
        os.fchmod(stream.fileno(), 0o600)
        stream.write(line.rstrip("\n") + "\n")
        stream.flush()
        os.fsync(stream.fileno())


def log(**fields):
    fields = {"ts": time.time(), "ts_ct": now_ct(), "pid": os.getpid(), **fields}
    append(LOG, json.dumps(fields, separators=(",", ":")))


def log_error(where):
    """Exception type and frames only: messages may carry the URL or key. Never raises,
    so a recovery path that logs (classify, record_step) still goes on to report."""
    try:
        kind, _, tb = sys.exc_info()
        frames = " <- ".join("%s:%d" % (frame.name, frame.lineno)
                             for frame in reversed(traceback.extract_tb(tb)))
        append(ERRORS, "%s %s pid=%d %s at %s" % (now_ct(), where, os.getpid(),
                                                  getattr(kind, "__name__", kind), frames))
    except Exception:
        pass


# --- process facts -----------------------------------------------------------

def cmdline(pid):
    try:
        raw = Path("/proc/%d/cmdline" % pid).read_bytes()
    except OSError:
        return []
    return [part.decode("utf-8", "replace") for part in raw.split(b"\0") if part]


def parent(pid):
    try:
        stat = Path("/proc/%d/stat" % pid).read_text()
    except OSError:
        return 0
    return int(stat.rpartition(")")[2].split()[1])


def start_ticks(pid):
    """Kernel start time of a process in clock ticks since boot, or None when it is gone.
    Exact, so it tells a process from a later one that reused its pid."""
    try:
        stat = Path("/proc/%d/stat" % pid).read_text()
    except OSError:
        return None
    return int(stat.rpartition(")")[2].split()[19])


def alive(pid, ticks):
    """The process that started at ticks still runs (not exited, zombie or replaced)."""
    try:
        fields = Path("/proc/%d/stat" % pid).read_text().rpartition(")")[2].split()
    except OSError:
        return False
    return fields[0] not in ("Z", "X") and int(fields[19]) == ticks


def epoch(ticks):
    btime = next(int(line.split()[1]) for line in Path("/proc/stat").read_text().splitlines()
                 if line.startswith("btime "))
    return btime + ticks / os.sysconf("SC_CLK_TCK")


def in_lane_unit(pid):
    """The process runs in a lane unit started by the launch recipe (sats-lane-<lane>.service)."""
    try:
        path = Path("/proc/%d/cgroup" % pid).read_text().strip().splitlines()[-1].split("::", 1)[-1]
    except (OSError, IndexError):
        return False
    return any(re.fullmatch(r"sats-lane-.+\.service", part) for part in path.split("/"))


def cwd_of(pid):
    try:
        return os.path.realpath(os.readlink("/proc/%d/cwd" % pid))
    except OSError:
        return ""


def agent_kind(argv):
    """claude, codex or None for one process argv."""
    if not argv:
        return None
    if any(Path(arg).name in ("claude", "claude.exe") for arg in argv[:2]):
        return "claude"
    if Path(argv[0]).name == "codex":
        return "codex"
    return None


def non_interactive(kind, argv):
    if kind == "claude":
        return "-p" in argv or "--print" in argv
    return kind == "codex" and "exec" in argv


def find_agent(agent):
    """Nearest ancestor that is the agent process, with its argv."""
    pid = os.getppid()
    for _ in range(12):
        if pid <= 1:
            break
        argv = cmdline(pid)
        if agent_kind(argv) == agent:
            return pid, argv
        pid = parent(pid)
    return 0, []


def launch_of(pack, pid):
    """(lane, launched pid) when this agent belongs to a launch recorded in the pack.

    Every launch records the process it started in <pack>/<lane>.pid (the launch
    recipe, Hash's run-lane scripts) or <lane>.worker.pid (the old sats-spawn-lane
    wrapper). Walking up from the agent, the first recorded pid reached before any
    other agent process is its launch. Reviewers and helpers a lane starts reach the
    lane's agent first, or no recorded pid when started detached, and stay silent."""
    recorded = {}
    try:
        files = sorted(Path(pack).glob("*.pid"))
    except OSError:
        return None
    for path in files:
        try:
            value = path.read_bytes().decode("ascii").strip()
            written = path.stat().st_mtime
        except (OSError, UnicodeDecodeError):
            continue
        if not re.fullmatch(r"[0-9]{1,10}", value):
            continue
        ticks = start_ticks(int(value))
        # A pid file is written just after its process starts; a process that started
        # later only reused the number, and the file is stale.
        if ticks is None or epoch(ticks) > written + 2:  # btime is whole seconds
            continue
        name = path.name[:-len(".pid")]
        recorded.setdefault(int(value), name[:-len(".worker")] if name.endswith(".worker") else name)
    current = pid
    for _ in range(16):
        if current in recorded:
            return recorded[current], current
        current = parent(current)
        if current <= 1 or agent_kind(cmdline(current)):
            return None
    return None


def wait_exit(pid, ticks):
    """Block until the agent process exits. Event-driven through a pidfd; if no
    pidfd can be had (fd exhaustion and the like), check the process every 2 s."""
    while True:
        try:
            fd = os.pidfd_open(pid)
            break
        except ProcessLookupError:
            return
        except OSError:
            if not alive(pid, ticks):
                return
            time.sleep(2)
    try:
        if start_ticks(pid) != ticks:
            return  # the pid now belongs to another process
        poller = select.poll()
        poller.register(fd, select.POLLIN)
        poller.poll()
    finally:
        os.close(fd)


# --- event -------------------------------------------------------------------

def read_event(agent, args):
    if agent == "claude":
        raw = sys.stdin.read()
    else:
        raw = args[-1] if args else "{}"
    try:
        event = json.loads(raw or "{}")
    except ValueError:
        event = {}
    return event if isinstance(event, dict) else {}


def describe(agent, event):
    """(event name, run id, reason) for one hook or notify call."""
    if agent == "claude":
        name = event.get("hook_event_name") or "unknown"
        reason = name
        if name == "SessionEnd":
            reason = "SessionEnd:%s" % (event.get("reason") or "unknown")
        elif name == "StopFailure":
            error = event.get("error") or event.get("error_type") or event.get("reason") or ""
            reason = ("StopFailure:%s" % error)[:200]
        return name, str(event.get("session_id") or ""), reason
    name = event.get("type") or "unknown"
    run = "%s/%s" % (event.get("thread-id") or "", event.get("turn-id") or "")
    return name, run, name


def bare(line):
    return line.replace("**", "").strip().strip("#*> ").strip()[:200]


def verdict_line(path):
    """The first PASS/FAIL/BLOCKED/PARTIAL line of one RESULT, else the first line under a
    "Verdict" heading or after "Verdict:", else None."""
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return None
    for line in lines:
        if VERDICT_RE.search(line):
            return bare(line)
    for index, line in enumerate(lines):
        text = bare(line)
        if VERDICT_KEY_RE.match(text):
            return text
        if line.lstrip().startswith("#") and text.lower() == "verdict":
            return next((bare(after) for after in lines[index + 1:] if bare(after)), None)
    return None


def files(pack, pattern):
    """(mtime, size, path) of the regular files matching pattern, newest first."""
    found = []
    try:
        for path in Path(pack).glob(pattern):
            try:
                if path.is_file():
                    stat = path.stat()
                    found.append((stat.st_mtime, stat.st_size, path))
            except OSError:
                continue
    except OSError:
        pass
    return sorted(found, key=lambda item: item[0], reverse=True)


def result_of(pack, since):
    """(file name, verdict line or None, written since the start) for the RESULT* that
    answers the run: the newest with a verdict line, one written since the start first;
    else the newest RESULT* with none. (None, None, False) when the pack has no RESULT*."""
    found = [(mtime >= since, path, verdict_line(path)) for mtime, _, path in files(pack, "RESULT*")]
    for fresh in (True, False):
        for is_fresh, path, line in found:
            if is_fresh == fresh and line:
                return path.name, line, fresh
    if found:
        return found[0][1].name, None, found[0][0]
    return None, None, False


def env_step():
    step = (os.environ.get("SATS_STEP") or "").strip().lower()
    return step if step in STEPS else None


def step_marker(key):
    return STATE / "sent" / (key + ".step")


def record_step(key):
    """Note the step this native event ran in, so the report at the end of the launch
    knows the step that ran last (a review after the producer that claimed the run)."""
    step = env_step()
    if step:
        tmp = step_marker(key).with_name("%s.tmp.%d" % (step_marker(key).name, os.getpid()))
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as stream:
            stream.write(step + "\n")
        os.replace(tmp, step_marker(key))


def lane_log_step(pack, since):
    """(mtime, step, exit code or None) from the last step line of <pack>/lane.log
    ("producer exit 0", "review start ...", "review exit 137"), when the log was written
    since the start; else None."""
    path = Path(pack) / "lane.log"
    try:
        stat = path.stat()
        if stat.st_mtime < since:
            return None
        with open(path, "rb") as stream:
            stream.seek(max(0, stat.st_size - 4096))
            lines = stream.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return None
    for line in reversed(lines):
        match = STEP_LINE_RE.match(line)
        if match:
            code = match.group(2)
            return stat.st_mtime, match.group(1).lower(), int(code) if code is not None else None
    return None


def review_outputs(pack, since):
    """(mtime, size, path) of the review outputs written since the start, newest first: REVIEW-SOL*.md
    (REVIEW-SOL.md, REVIEW-SOL.rN.md), else any REVIEW*. At equal mtimes the higher round wins."""
    for pattern in ("REVIEW-SOL*.md", "REVIEW*"):
        found = [item for item in files(pack, pattern) if item[0] >= since]
        if found:
            def order(item):
                round_ = ROUND_RE.search(item[2].name)
                return item[0], int(round_.group(1)) if round_ else 0
            return sorted(found, key=order, reverse=True)
    return []


def review_verdict(path):
    r"""ACCEPT or REQUEST_CHANGES when the first non-blank line of a review output, trimmed of spaces and
    tabs, starts with that word, else None. The same rule as the repair loops' verdict():
    LC_ALL=C awk 'NF{gsub(/^[ \t]+|[ \t]+$/,""); print; exit}' | LC_ALL=C grep -aoE '^(ACCEPT|REQUEST_CHANGES)\b'."""
    try:
        with open(path, "rb") as stream:
            for raw in stream:
                line = raw.decode("utf-8", "replace").rstrip("\n").strip(" \t")
                if line:
                    match = REVIEW_VERDICT_RE.match(line)
                    return match.group(1) if match else None
    except OSError:
        pass
    return None


def last_step(run):
    """(step or None, exit code or None, step-line seen, unreported) for the step that ran last.
    unreported: only a review output newer than every logged or marked step shows the review ran."""
    entry = lane_log_step(run["pack"], run["since"])
    candidates = [(entry[0], entry[1], False)] if entry else []
    try:
        marker = step_marker(run["key"])
        value = marker.read_text(encoding="utf-8", errors="replace").strip()
        if value in STEPS:
            candidates.append((marker.stat().st_mtime, value, False))
    except (OSError, ValueError):
        pass
    # A review writes REVIEW-SOL*.md as it starts (codex exec > REVIEW-SOL.rN.md), so one newer than the last
    # logged or marked step is a review that a repair loop never logged, killed before it sent a native event.
    # Appended last, so a log line or marker at the same mtime wins.
    reviews = [item for item in files(run["pack"], "REVIEW-SOL*.md") if item[0] >= run["since"]]
    if reviews and candidates:
        candidates.append((reviews[0][0], "review", True))
    fixed = LANE_STEP_RE.search(run["lane"])
    unreported = False
    if candidates:
        _, step, unreported = max(candidates, key=lambda item: item[0])
    elif fixed:
        step = fixed.group(1).lower()
    else:
        step = run.get("step")
    if entry and entry[1] == step and not unreported:
        return step, entry[2], True, False
    return step, None, False, unreported


def blank(path):
    """True when a review output holds nothing but whitespace (or cannot be read)."""
    try:
        with open(path, "rb") as stream:
            return not stream.read(65536).strip()
    except OSError:
        return True


def classify(run):
    """(outcome, verdict text, fields) for a run, read once the launch has exited."""
    result, line, fresh = result_of(run["pack"], run["since"])
    step, code, logged, unreported = last_step(run)
    fields = {"step": step, "step_name": None, "result_file": result, "result_verdict": line,
              "result_fresh": fresh, "review_verdict": None, "rerun": "none"}
    if not result:  # the producer left nothing, whatever step ran after it
        fields["rerun"] = "producer"
        return "DIED", "DIED", fields
    stands = "%s: %s" % (result, line or "no verdict line")
    if step in ("review", "retry"):
        outputs = review_outputs(run["pack"], run["since"])
        name = outputs[0][2].stem if outputs else None
        said = review_verdict(outputs[0][2]) if outputs and step == "review" else None
        # A review must leave REVIEW* output; a retry may leave none, but not an empty or all-whitespace one.
        empty = (not outputs and step == "review") or bool(outputs and blank(outputs[0][2]))
        # A "review start" line with no exit after it, or a review that neither logged an exit nor sent
        # its native event (killed in a loop that writes no start line). A review that wrote its verdict was
        # not cut off, logged exit or not.
        cut = not said and (logged or unreported) and code is None
        unit_failed = code is None and not cut and run.get("unit_failed")  # ExecStopPost only
        # A review that wrote its verdict finished, whatever its exit; only one without a verdict re-runs.
        failed = not said and ((code is not None and code != 0) or cut or unit_failed or empty)
        fields["step_name"] = name
        fields["review_verdict"] = said
        if failed:
            fields["rerun"] = "step:" + step
        if code is not None:
            notes = ["exit %d" % code]
        elif cut:
            notes = ["cut off"]
        elif unit_failed:
            notes = ["unit ended %s" % run.get("unit_exit")]
        else:
            notes = ["exit not logged"]
        if empty:
            notes.append("%s empty" % outputs[0][2].name if outputs else "no REVIEW* output")
        if failed:
            notes.append("re-run this step only")
        label = "step %s%s" % (step, " (%s)" % name if name else "")
        if said == "ACCEPT":
            return "DONE", ("ACCEPTED: %s, %s, review ACCEPT. %s" % (label, ", ".join(notes), stands))[:300], fields
        if said == "REQUEST_CHANGES":
            notes.append("changes requested, repair then review again")
        return step.upper(),("%s STOP: %s, %s. %s" % (step.upper(), label, ", ".join(notes), stands))[:300], fields
    if not fresh:
        return "RETRY", ("RETRY STOP: step %s ended with no new RESULT. %s (predates this start): %s"
                         % (step or "unknown", result, line or "no verdict line"))[:300], fields
    return "DONE", line or ("DONE: %s has no verdict line" % result), fields


# --- delivery ----------------------------------------------------------------

def usable(url, key):
    try:
        parts = urllib.parse.urlsplit(url or "")
        parts.hostname
    except ValueError:
        return False
    return (parts.scheme in ("http", "https") and bool(parts.hostname)
            and not re.search(r"\s", url) and key is not None and not re.search(r"\s", key))


def loopback(url):
    try:
        host = urllib.parse.urlsplit(url).hostname or ""
    except ValueError:
        return False
    return host in ("127.0.0.1", "localhost", "::1")


def webhook(refresh=False, *, cached_only=False):
    """(url, key, source) or (None, None, why)."""
    url = os.environ.get("SATS_COMPLETION_WEBHOOK_URL")
    if url:
        key = os.environ.get("SATS_COMPLETION_WEBHOOK_KEY", "")
        if not usable(url, key) or not loopback(url):
            return None, None, "override-not-loopback"
        return url, key, "override-loopback"
    if not refresh:
        try:
            if time.time() - CACHE.stat().st_mtime < CACHE_TTL:
                cached = json.loads(CACHE.read_text())
                if usable(cached.get("url"), cached.get("key")) and cached.get("key"):
                    return cached["url"], cached["key"], "cache"
        except (OSError, ValueError, AttributeError):
            pass
    if cached_only:
        return None, None, "cache-unavailable"
    try:
        out = subprocess.run(
            [str(SATS_OP), "item", "get", OP_ITEM, "--vault", OP_VAULT, "--fields", "label=url,label=key",
             "--reveal", "--format", "json"],
            capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.TimeoutExpired):
        return None, None, "sats-op-unavailable"
    if out.returncode != 0:
        return None, None, "1password-item-missing"
    try:
        fields = json.loads(out.stdout)
    except ValueError:
        return None, None, "1password-item-unreadable"
    if isinstance(fields, dict):
        fields = [fields]
    values = {f.get("label"): f.get("value") for f in fields if isinstance(f, dict)}
    if not values.get("key") or not usable(values.get("url"), values.get("key")):
        return None, None, "1password-item-incomplete"
    write_private(CACHE, {"url": values["url"], "key": values["key"]})
    return values["url"], values["key"], "1password"


class NoRedirect(urllib.request.HTTPRedirectHandler):
    """A redirect would resend the Authorization header to another URL."""

    def redirect_request(self, *args, **kwargs):
        return None


OPENER = urllib.request.build_opener(NoRedirect)


WAKE_FILTER = HOME / ".local/bin/grok-wake-filter"  # token fix 2026-10-11: drop no-action wakes before the POST


def wake_filter(verb, body, *extra):
    """grok-wake-filter check|mark|ack; returns (exit code, stdout). Any failure -> (0, "") (fail open: the POST goes)."""
    try:
        r = subprocess.run([str(WAKE_FILTER), verb, *extra, "--sender", "sats-completion-notify"], input=body,
                           stdout=subprocess.PIPE, stderr=subprocess.DEVNULL, timeout=10)
        return r.returncode, r.stdout.decode("utf-8", "replace")
    except Exception:
        return 0, ""


def post_result(url, key, body, idempotency):
    try:
        payload = json.loads(body)
    except ValueError:
        payload = {}
    required = isinstance(payload, dict) and payload.get("delivery_contract") == "lane-required-v2"
    # v3 2026-10-11 (Victor GO 11:23 CT): check --emit-body. 10 = dropped; 11 = held (a DONE without a verdict line or a
    # PARTIAL; the watcher releases it as-is after 30 min); "MERGE <id>" + a body = a held step of this lane rides in
    # this post: POST that body, then mark it and ack the hold. Odd output posts the original body (fail open).
    # An exact owner-bound occurrence cannot be dropped, held or merged into a
    # different body. Keep native and explicit required notices on this contract.
    code, out = (0, "") if required else wake_filter("check", body, "--emit-body", "--idem", idempotency)
    if code in (10, 11, 299):
        return {"state": "FAILED", "disposition": "dropped" if code == 10 else "deferred",
                "http_status": None, "network_attempted": False, "filter_exit": code,
                "native_recipient_delivery": "unavailable"}
    send, merge_id = body, None
    lines = out.split("\n")
    m = re.match(r"MERGE ([0-9a-f]{8,64}) ", lines[0]) if lines else None
    if m and len(lines) > 1 and lines[1].strip():
        try:
            merged = json.loads(lines[1])
            if isinstance(merged, dict):
                send, merge_id = json.dumps(merged, separators=(",", ":")).encode(), m.group(1)
        except ValueError:
            pass
    diagnostics = {}
    status = _post(url, key, send, idempotency, diagnostics=diagnostics)
    if accepted_status(status):
        if required:
            write_private(STATE / "outbox" / (payload["event_id"] + ".acceptance.json"),
                          {"http_status": status, "body_sha256": hashlib.sha256(send).hexdigest()})
        else:
            wake_filter("mark", send)
            if merge_id:
                wake_filter("ack", b"", merge_id)
    return {"state": "WEBHOOK_ACCEPTED" if accepted_status(status) else "FAILED",
            "disposition": "webhook_accepted" if accepted_status(status) else "http_failed",
            "http_status": status, "network_attempted": True, "filter_exit": code,
            "native_recipient_delivery": "unavailable", **diagnostics}


def post(url, key, body, idempotency):
    """Legacy integer API. Local drop/defer returns 0, never an invented 2xx.

    Callers needing local policy states must migrate to post_result().
    This preserves the frozen wake-seat caller's integer comparison.
    """
    result = post_result(url, key, body, idempotency)
    return result["http_status"] if result["http_status"] is not None else 0


def unavailable_http_error_body(reason):
    return {"representation": "allowlisted_projection", "raw_body_retained": False,
            "body_available": False, "unavailable_reason": reason,
            "body_sha256": None, "hash_scope": "unavailable", "body_size_bytes": None,
            "captured_bytes": 0, "capture_limit_bytes": HTTP_ERROR_BODY_LIMIT,
            "truncated": None, "format": "unavailable", "diagnostics": {}}


def quota_count(value):
    # Counts alone are diagnostic. Booleans, strings, floats and large numbers
    # can carry arbitrary echoed data and are never copied to the projection.
    return type(value) is int and 0 <= value <= 2147483647


def error_fields(value, depth=0):
    """Recognize exact messages/codes only along approved error wrappers.

    No recursive search through request/headers/URLs or arbitrary nested keys.
    Unknown strings, including messages with appended secrets, retain no text.
    """
    if isinstance(value, str):
        match = QUOTA_ERROR_RE.fullmatch(value)
        if match:
            limit, count = map(int, match.groups())
            if quota_count(limit) and quota_count(count):
                return {"classification": "automation_global_rate_limit",
                        "limit": limit, "current_count": count, "period_seconds": 60}
    elif isinstance(value, dict) and depth < 4:
        code = value.get("code")
        classification = HTTP_ERROR_CODES.get(code) if isinstance(code, str) else None
        if classification:
            fields = {"classification": classification}
            if classification == "automation_global_rate_limit":
                for name in ("limit", "current_count"):
                    count = value.get(name)
                    if quota_count(count):
                        fields[name] = count
                # Only explicit per-minute messages establish a time window.
            return fields
        for name in ("error", "message", "detail"):
            fields = error_fields(value.get(name), depth + 1)
            if fields:
                return fields
    return {}


def project_http_error_body(error):
    """Read at most limit+1 bytes; hash the capture and retain an allowlist.

    No HTTP headers or reason strings are inspected. Full bytes are unavailable
    after projection. Truncated hashes identify a prefix, never the whole body.
    """
    chunks, size = [], 0
    while size <= HTTP_ERROR_BODY_LIMIT:
        chunk = error.read(HTTP_ERROR_BODY_LIMIT + 1 - size)
        if not isinstance(chunk, bytes):
            return unavailable_http_error_body("read_failed")
        if not chunk:
            break
        chunks.append(chunk)
        size += len(chunk)
    raw = b"".join(chunks)
    truncated = len(raw) > HTTP_ERROR_BODY_LIMIT
    captured = raw[:HTTP_ERROR_BODY_LIMIT]
    projection = {"representation": "allowlisted_projection", "raw_body_retained": False,
                  "body_available": True, "body_sha256": hashlib.sha256(captured).hexdigest(),
                  "hash_scope": "captured_prefix" if truncated else "full_body",
                  "body_size_bytes": None if truncated else len(raw),
                  "captured_bytes": len(captured), "capture_limit_bytes": HTTP_ERROR_BODY_LIMIT,
                  "truncated": truncated, "format": "unclassified", "diagnostics": {}}
    if truncated:
        return projection  # a prefix cannot establish a complete message/JSON value
    if not captured:
        projection["format"] = "empty"
        return projection
    try:
        text = captured.decode("utf-8")
    except UnicodeError:
        projection["format"] = "invalid_utf8"
        return projection
    try:
        value = json.loads(text)
        projection["format"] = "json"
    except (ValueError, RecursionError):
        projection["format"] = "text"
        value = text
    projection["diagnostics"] = error_fields(value)
    return projection


def _post(url, key, body, idempotency, *, timeout=30, diagnostics=None):
    try:
        request = urllib.request.Request(url, data=body, method="POST", headers={
            "Content-Type": "application/json",
            "Authorization": "Bearer %s" % key,
            "Idempotency-Key": idempotency,
        })
        with OPENER.open(request, timeout=timeout) as response:
            return response.status
    except urllib.error.HTTPError as error:
        code = error.code
        try:
            if diagnostics is not None:
                try:
                    projection = project_http_error_body(error)
                except Exception:
                    projection = unavailable_http_error_body("projection_failed")
                diagnostics["http_error_body"] = projection
        except Exception:
            pass  # retention cannot change status, retry policy or hook behavior
        finally:
            try:
                error.close()
            except Exception:
                pass  # never retain an exception message, URL or headers
        return code
    except (urllib.error.URLError, OSError, ValueError):
        return 0


NOTICE_KINDS = {"start", "step", "blocker", "decision", "done", "stalled", "review_result", "canceled"}


def notice_message(payload):
    """Free text forwarded unchanged by the model-backed Lightning consumer.

    The Grok receiver sees this text, sender name/id and native priority only.
    JSON scalar quoting keeps newlines in source facts off the identity lines.
    """
    fields = {
        "lane": payload["lane"], "run": payload["run"], "kind": payload["event_kind"],
        "round": payload["review_round"], "step": payload.get("step"),
        "occurrence": payload["notice_occurrence"], "recipient": payload["recipient"],
        "priority": payload["priority"], "outcome": payload.get("outcome"),
        "producer_verdict": payload.get("result_verdict"),
        "review_verdict": payload.get("review_verdict"),
        "review_status": "source_review_recorded" if payload.get("review_verdict") else "unreviewed",
        "verdict": payload.get("verdict"), "reason": payload.get("reason"),
        "rerun": payload.get("rerun"), "cancel_receipt_id": payload.get("cancel_receipt_id"),
    }
    if "milestone_message" in payload:
        fields.update(message=payload["milestone_message"], path=payload["path"])
    if payload.get("notice_binding", {}).get("owner_thread_id"):
        fields["owner_thread_id"] = payload["notice_binding"]["owner_thread_id"]
    return "LANE_NOTICE " + payload["event_id"] + "\n" + "\n".join(
        name + ": " + json.dumps(value, ensure_ascii=True, separators=(",", ":"))
        for name, value in fields.items())


def accepted_status(status):
    """299 is the historical local suppression sentinel, never acceptance."""
    return type(status) is int and 200 <= status < 300 and status != 299


def parse_local_binding(raw, lane, run):
    def distinct_keys(pairs):
        value = {}
        for key, item in pairs:
            if key in value:
                raise ValueError("duplicate binding field")
            value[key] = item
        return value
    binding = json.loads(raw, object_pairs_hook=distinct_keys)
    if not valid_binding(binding, lane, run):
        raise ValueError("invalid local binding")
    return binding


def enroll_owner_binding(binding, *, preserve_existing=False, authority="local launch binding"):
    """Enroll local authority before transport, using the refresher's stable lock.

    Default proposals yield to an exact owner-held mapping. Explicit local
    mappings must agree with history for transport. Registry health, capacity,
    conflict and helper failures leave a local-only gap. Caller validation and
    durable local proof writes remain outside this helper error boundary.
    The consumer continues to validate its independent registry on ingress.
    """
    if not isinstance(binding, dict) or not valid_binding(binding, binding.get("lane"), binding.get("run")):
        raise ValueError("invalid enrollment binding")
    proposed_binding = dict(binding)
    try:
        helper = types.ModuleType("local_owner_enrollment")
        helper.__file__ = str(OWNER_BINDINGS_HELPER)
        exec(compile(OWNER_BINDINGS_HELPER.read_bytes(), str(OWNER_BINDINGS_HELPER), "exec"), helper.__dict__)
        entry = {"binding": dict(binding), "owner": LOCAL_NOTICE_OWNER,
                 "authority": authority, "notice_binding_used": authority == "local launch binding",
                 "emission_verified": False}
        added, _ = helper.merge(OWNER_BINDINGS_REGISTRY, [entry], retain_existing=preserve_existing)
        enrolled_binding = entry["binding"]
        if not valid_binding(enrolled_binding, proposed_binding["lane"], proposed_binding["run"]):
            raise ValueError("invalid helper binding")
        binding = enrolled_binding
        receipt = {"state": "ENROLLED", "disposition": "added" if added else "already_enrolled"}
    except Exception:
        binding = proposed_binding
        receipt = {"state": "UNAVAILABLE", "disposition": "owner_enrollment_unavailable"}
    # Retain a durable gap independently of any HTTP attempt ledger.
    ensure_state()
    log(action="owner-enrollment", lane=binding["lane"], run=binding["run"], **receipt)
    return binding, receipt


def notice_binding(lane, run, test):
    """Enroll the exact native identity from local launch authority or policy."""
    if test or lane.upper().startswith("TEST"):
        return None
    raw = os.environ.get("SATS_NOTICE_BINDING")
    try:
        binding = parse_local_binding(raw, lane, run) if raw is not None else {
            "lane": lane, "run": run, "recipient": DEFAULT_NOTICE_RECIPIENT, "priority": True}
        binding, _ = enroll_owner_binding(binding, preserve_existing=raw is None,
            authority="local launch binding" if raw is not None else "local native owner policy")
        return binding
    except ValueError:
        ensure_state()
        log(action="binding-rejected")  # never include supplied values or exception text
        raise ValueError("local binding rejected") from None


def valid_binding(binding, lane, run, test=False):
    return single_line(lane, 500) and single_line(run, 500) \
        and not test and not lane.upper().startswith("TEST") and isinstance(binding, dict) \
        and {"lane", "run", "recipient", "priority"} <= set(binding) \
        and set(binding) <= {"lane", "run", "recipient", "priority", "owner_thread_id"} \
        and binding.get("lane") == lane and binding.get("run") == run \
        and single_line(binding.get("recipient"), 500) and not binding["recipient"].upper().startswith("TEST") \
        and binding.get("priority") is True \
        and ("owner_thread_id" not in binding or
             single_line(binding["owner_thread_id"], 500))


def required_notice(payload, event_kind, review_round=0, occurrence="1", *, binding):
    """Prepare only a notice whose lane/run matches an explicit recipient binding."""
    if not valid_binding(binding, payload.get("lane", ""), payload.get("run"), payload.get("test", False)):
        raise ValueError("exact launch recipient binding required")
    if event_kind not in NOTICE_KINDS or not payload.get("lane") or not payload.get("run"):
        raise ValueError("notice identity required")
    if type(review_round) is not int or review_round < 0:
        raise ValueError("invalid review round")
    if event_kind == "review_result" and review_round < 1:
        raise ValueError("review_result requires a positive round")
    if not isinstance(occurrence, str) or not occurrence.strip():
        raise ValueError("immutable notice occurrence required")
    identity = {"lane": payload["lane"], "run": payload["run"], "event_kind": event_kind,
                "step": payload.get("step"), "review_round": review_round, "notice_occurrence": occurrence,
                "recipient": binding["recipient"], "priority": binding["priority"]}
    event_id = hashlib.sha256(json.dumps(identity, sort_keys=True, separators=(",", ":")).encode()).hexdigest()
    envelope = dict(payload, **identity, event_id=event_id, delivery_contract="lane-required-v2",
                    required_notice=True, notice_binding=dict(binding))
    envelope["message"] = notice_message(envelope)
    return envelope


def canceled(run):
    """Only a supplied, exact-run terminal cancel receipt changes the classification.

    No receipt is loaded from live state by this scratch candidate.
    Launch/cancel owners still must supply and authenticate the receipt.
    """
    receipt = run.get("cancel_receipt")
    return isinstance(receipt, dict) and receipt.get("run") == run["key"] \
        and receipt.get("terminal_confirmed") is True \
        and bool(receipt.get("receipt_id")) and bool(receipt.get("invocation_id"))


def finish(run):
    """Payload for a run, read once the agent has exited."""
    try:
        if registered_launch_failed(run):
            outcome, text = "LAUNCH_FAILED", "LAUNCH_FAILED: command start not confirmed"
            fields = {"step": run.get("step"), "step_name": None, "result_file": None,
                      "result_verdict": None, "result_fresh": None, "review_verdict": None, "rerun": "producer"}
        elif canceled(run):
            outcome, text = "CANCELED", "CANCELED: exact run terminal receipt"
            fields = {"step": run.get("step"), "step_name": None, "result_file": None,
                      "result_verdict": None, "result_fresh": None, "review_verdict": None, "rerun": "none"}
        else:
            outcome, text, fields = classify(run)
    except Exception:  # a report with less detail beats no report from either poster
        log_error("classify")
        outcome, text = "UNKNOWN", "UNKNOWN: the hook could not classify this run; read the pack"
        fields = {"step": None, "step_name": None, "result_file": None, "result_verdict": None,
                  "result_fresh": None, "review_verdict": None, "rerun": "none"}
    reason = run["reason"]
    if outcome == "DIED":
        reason += "; no RESULT* in the pack"
        if fields["step"] in ("review", "retry"):
            reason += "; last step %s" % fields["step"]
    payload = {
        "lane": run["lane"],
        "pack": run["pack"],
        "host": socket.gethostname(),
        "agent": run["agent"],
        "verdict": text,
        "reason": reason,
        "ts_ct": now_ct(),
        "test": run["test"],
        "event": run["event"],
        "run": run["key"],
        "outcome": outcome,
        **fields,
    }
    if outcome == "CANCELED":
        payload["cancel_receipt_id"] = run["cancel_receipt"]["receipt_id"]
    match = ROUND_RE.search((fields.get("step_name") or "") + ".md")
    binding = run.get("notice_binding")
    if not valid_binding(binding, run["lane"], run["key"], run["test"]):
        return payload  # unbound and TEST lanes keep the legacy filter/consumer path
    if os.environ.get("SATS_MILESTONES") == "1":
        payload.update(milestone_message="terminal %s: %s" % (outcome, " ".join(text.split())),
                       path=str(Path(run["pack"]) / "LANE.json"))
    return required_notice(payload, "canceled" if outcome == "CANCELED" else "done",
                           int(match.group(1)) if match else 0, occurrence="launch-terminal", binding=binding)


def send(run, poster):
    """Reserve at most three attempts durably, shared by every poster/restart.

    The caller holds the run lock. An interrupted reservation consumes an attempt;
    uncertain transport outcomes never become acceptance or a fresh retry budget.
    """
    key = run["key"]
    outbox = STATE / "outbox" / (key + ".json")
    if not outbox.exists():
        write_private(outbox, finish(run))
    payload = json.loads(outbox.read_text())
    body = outbox.read_bytes()
    if run.get("test"):
        log(action="test-local-only", run=key, poster=poster)
        return "local-only"  # TEST never calls the filter, credential store or webhook
    if os.environ.get("SATS_MILESTONES") == "1":
        try:
            terminal_log(run, payload)
        except Exception:
            log_error("terminal-milestone")  # native hooks remain fail-open
    if valid_binding(run.get("notice_binding"), run["lane"], key):
        _, enrollment = enroll_owner_binding(run["notice_binding"])
        if enrollment["state"] != "ENROLLED":
            write_private(STATE / "outbox" / (key + ".enrollment-receipt.json"), {
                "state": "FAILED", "disposition": "owner_enrollment_unavailable",
                "native_recipient_delivery": "unavailable", "local_recorded": True})
            return "failed:owner_enrollment_unavailable"
    acceptance = STATE / "outbox" / (payload.get("event_id", key) + ".acceptance.json")
    if acceptance.exists():
        proof = json.loads(acceptance.read_text())
        if accepted_status(proof.get("http_status")) and proof.get("body_sha256") == hashlib.sha256(body).hexdigest():
            outbox.rename(STATE / "sent" / (key + ".json"))
            return "sent:%d" % proof["http_status"]
    attempts_path = STATE / "outbox" / (key + ".attempts.jsonl")
    records = [json.loads(line) for line in attempts_path.read_text().splitlines()] if attempts_path.exists() else []
    used = sum(record.get("phase") == "reserved" or "phase" not in record for record in records)
    refreshed = False
    status = 0
    for number in range(used + 1, len(RETRY_DELAYS) + 1):
        time.sleep(RETRY_DELAYS[number - 1])
        append(attempts_path, json.dumps({"phase": "reserved", "attempt": number,
               "run": key, "event_id": payload.get("event_id"), "poster": poster}))
        source = None
        try:
            url, secret, source = webhook()
            if url is None:
                receipt = {"state": "FAILED", "disposition": "deferred", "http_status": None,
                           "network_attempted": False, "native_recipient_delivery": "unavailable"}
            else:
                receipt = post_result(url, secret, body, payload.get("event_id", key))
        except Exception:
            log_error("native-transport")
            receipt = {"state": "FAILED", "disposition": "transport_unavailable", "http_status": None,
                       "native_recipient_delivery": "unavailable"}
        status = receipt["http_status"]
        append(attempts_path, json.dumps({"phase": "result", "attempt": number,
               "run": key, "event_id": payload.get("event_id"), "poster": poster, **receipt}))
        log(action="post", run=key, poster=poster, http=status, state=receipt["state"], lane=payload["lane"])
        if receipt["state"] == "WEBHOOK_ACCEPTED" and accepted_status(status):
            outbox.rename(STATE / "sent" / (key + ".json"))
            return "sent:%d" % status
        if receipt["disposition"] in ("dropped", "deferred", "transport_unavailable"):
            return "failed:%s" % receipt["disposition"]
        if status in (401, 403, 404) and source == "cache" and not refreshed:
            try:
                webhook(refresh=True)
            except Exception:
                log_error("native-credential-refresh")
                return "failed:credential_refresh_unavailable"
            refreshed = True
    return "failed:%s:attempt-cap-3" % status


def deliver_once(run, poster):
    """Serialize posters, honoring only a real accepted status, never legacy 299."""
    key = run["key"]
    fd = os.open(STATE / "outbox" / (key + ".lock"), os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        prior = os.pread(fd, 200, 0).decode("ascii", "replace").strip()
        match = re.match(r"sent:([0-9]{3})(?: |$)", prior)
        if match and accepted_status(int(match.group(1))):
            log(action="dup suppressed", run=key, poster=poster)
            return prior
        if (STATE / "sent" / (key + ".json")).exists():
            # Legacy sent files without a real acceptance receipt require owner reconciliation.
            return "failed:legacy-unverified-acceptance"
        outcome = send(run, poster)
        os.ftruncate(fd, 0)
        os.pwrite(fd, ("%s by %s\n" % (outcome, poster)).encode(), 0)
        os.fsync(fd)
        return outcome
    finally:
        os.close(fd)


def deliver(run):
    """Runs in the detached child: wait for the agent to exit, then POST once."""
    started = time.time()
    wait_exit(run["pid"], run["ticks"])
    log(action="exit", run=run["key"], waited_ms=int((time.time() - started) * 1000))
    deliver_once(run, "native")


def spawn(run):
    """Fork a session-detached sender so the hook returns before delivery.
    Returns False when no sender could start."""
    try:
        child = os.fork()
    except OSError:
        return False
    if child > 0:
        _, status = os.waitpid(child, 0)  # the middle process exits at once
        return os.waitstatus_to_exitcode(status) == 0
    code = 1
    try:
        os.setsid()
        # In a lane unit systemd TERMs the leftover processes when the main one exits and
        # starts ExecStopPost once they are gone, so the sender finishes its POST first.
        signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGTERM, signal.SIGINT, signal.SIGHUP})
        if os.fork() > 0:
            os._exit(0)
        code = 0
        devnull = os.open(os.devnull, os.O_RDWR)
        for fd in (0, 1, 2):
            os.dup2(devnull, fd)
        os.closerange(3, 1024)  # no inherited hook pipes keep the agent waiting
        deliver(run)
    except BaseException:
        try:
            log_error("deliver")
        except BaseException:
            pass
    os._exit(code)


# --- main --------------------------------------------------------------------

def lane_label(lane):
    """(lane as reported, test flag). Test lanes carry a TEST- prefix."""
    test = os.environ.get("SATS_TEST") == "1" or lane.upper().startswith("TEST")
    if test and not lane.upper().startswith("TEST"):
        lane = "TEST-" + lane
    return lane, test


def unit_run():
    """(key tail, launch time or None) for the systemd launch recipe, which sets SATS_RUN.
    The launch time, to the nanosecond, is the RESULT cutoff for both reporters. A missing
    or malformed SATS_RUN falls back to the unit's INVOCATION_ID, which the agent's hooks
    and ExecStopPost share, so both reporters still use one key."""
    match = RUN_RE.fullmatch(os.environ.get("SATS_RUN") or "")
    if match:
        return "run-" + match.group(0), int(match.group(1)) + int(match.group(2)) / 1e9
    invocation = os.environ.get("INVOCATION_ID", "")
    if not re.fullmatch(r"[a-fA-F0-9]{32}", invocation):
        raise ValueError("valid local invocation required")
    return "run-bad-" + invocation, None


def run_key(lane, tail):
    safe = re.sub(r"[^A-Za-z0-9._-]", "_", lane)[:60]
    digest = hashlib.sha256(lane.encode()).hexdigest()[:10]
    return "%s-%s-%s" % (safe, digest, tail)


def claim(key):
    """True for the first native event of a run, False for every later one."""
    # Claims made before 18:14 CDT on 2026-10-07 put the agent type in front of the key.
    if any((STATE / "sent" / ("%s-%s.claim" % (kind, key))).exists() for kind in ("claude", "codex")):
        return False
    try:
        os.close(os.open(STATE / "sent" / (key + ".claim"), os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600))
    except FileExistsError:
        return False
    return True


def native_run(launched, ticks):
    """(key tail, RESULT cutoff) for a native event of the launch (launched pid, start ticks).
    A systemd lane (SATS_RUN set, or the launch runs in a sats-lane unit) uses the same
    identity as its ExecStopPost; a plain-nohup lane uses the launched process."""
    if "SATS_RUN" in os.environ or in_lane_unit(launched):
        tail, launch_time = unit_run()
        return tail, epoch(ticks) if launch_time is None else launch_time
    return "%d-%d" % (launched, ticks), epoch(ticks)


def exit_report(argv):
    """ExecStopPost of a lane unit: report the exit unless a native hook already did."""
    raw = os.environ.get("SATS_LANE")
    if not raw:
        return
    ensure_state()
    lane, test = lane_label(raw)
    tail, launched = unit_run()
    reason = "systemd result=%s code=%s status=%s" % tuple(
        re.sub(r"[^A-Za-z0-9._-]", "_", os.environ.get(name, "unknown"))[:40]
        for name in ("SERVICE_RESULT", "EXIT_CODE", "EXIT_STATUS"))
    if launched is None:
        reason += "; SATS_RUN missing or malformed"
    status = tuple(os.environ.get(name, "unknown") for name in ("SERVICE_RESULT", "EXIT_CODE", "EXIT_STATUS"))
    unit_failed = status != ("success", "exited", "0")
    unit_exit = re.sub(r"[^A-Za-z0-9._/-]", "_", "%s/%s" % status[1:])[:40]
    since = time.time() if launched is None else launched
    agent = re.sub(r"[^A-Za-z0-9._-]", "_", argv[0])[:20] if argv else "unknown"
    key = run_key(lane, tail)
    log(action="unit-exit", run=key, lane=lane, reason=reason)
    run_info = {"key": key, "agent": agent, "lane": lane, "test": test,
                  "pack": os.environ.get("SATS_PACK") or os.getcwd(), "since": since,
                  "raw_run": os.environ.get("SATS_RUN") or os.environ.get("INVOCATION_ID") or key,
                  "event": "ExecStopPost", "reason": reason, "step": env_step(),
                  "unit_failed": unit_failed, "unit_exit": unit_exit,
                  "notice_binding": notice_binding(lane, key, test)}
    if os.environ.get("SATS_MILESTONES") == "1":
        try:
            payload = terminal_payload(run_info)
            mark_terminal(run_info, payload)
        except Exception:
            log_error("terminal-registry")
    deliver_once(run_info, "systemd")


def run(argv):
    if argv and argv[0] == "exit":
        exit_report(argv[1:])
        return
    if not argv or argv[0] not in ("claude", "codex"):
        return
    agent = argv[0]
    event = read_event(agent, argv[1:])
    pid, agent_argv = find_agent(agent)
    if not pid or not non_interactive(agent, agent_argv):
        return  # interactive session, or not called by an agent
    pack = os.environ.get("SATS_PACK") or cwd_of(pid) or os.path.realpath(event.get("cwd") or os.getcwd())
    launch = launch_of(pack, pid)
    if launch is None:
        if os.environ.get("SATS_LANE"):
            ensure_state()
            log(action="helper", lane=os.environ["SATS_LANE"], agent_pid=pid)
        return  # not a lane worker: helper, reviewer, or an agent no launch recorded
    owner, launched = launch
    ticks = start_ticks(launched)
    if ticks is None:
        return
    lane, test = lane_label(os.environ.get("SATS_LANE") or owner)
    ensure_state()
    name, run_id, reason = describe(agent, event)

    # One signal per launch: later events of it, from this agent or another it ran, are dropped.
    tail, since = native_run(launched, ticks)
    key = run_key(lane, tail)
    try:
        record_step(key)
    except (OSError, ValueError):
        log_error("record_step")  # the step is detail; the claim and report still go ahead
    if not claim(key):
        log(action="dedup", run=key, event=name)
        return
    log(action="claim", run=key, event=name, lane=lane, agent_pid=pid, launched_pid=launched, run_id=run_id)
    run_info = {"key": key, "agent": agent, "lane": lane, "pack": str(pack), "pid": launched,
                "since": since, "ticks": ticks, "test": test, "event": name, "reason": reason,
                "raw_run": os.environ.get("SATS_RUN") or os.environ.get("INVOCATION_ID") or key,
                "step": env_step(), "notice_binding": notice_binding(lane, key, test)}
    if not spawn(run_info):
        # Preserve the failed claim as evidence while allowing the next event to retry.
        marker = STATE / "sent" / (key + ".claim")
        marker.rename(marker.with_name(marker.name + ".abandoned.%d" % time.time_ns()))
        log(action="spawn-failed", run=key, event=name)


# --- explicit milestones and launch registration -----------------------------

MILESTONE_KINDS = ("start", "step", "blocker", "decision", "done", "stalled")
LANE_ID_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,79}")


def configure_state(path):
    """Invocation-local override for isolated tests. Native hooks use the default."""
    global STATE, LOG, ERRORS, CACHE
    STATE = Path(path)
    if not STATE.is_absolute():
        raise ValueError("absolute state directory required")
    LOG, ERRORS, CACHE = STATE / "hook.log", STATE / "errors.log", STATE / "webhook.json"


def single_line(value, limit=4096):
    return isinstance(value, str) and bool(value.strip()) and len(value) <= limit and not any(
        ord(c) < 32 or ord(c) == 127 or c in "\u0085\u2028\u2029" for c in value)


def binding_key(lane, raw_run):
    """Both launch and explicit emitter use the native systemd run identity."""
    return run_key(lane, "run-" + raw_run) if RUN_RE.fullmatch(raw_run) else raw_run


def registration_run(lane, run):
    """Reverse the standard binding alias only for this exact lane.

    Transport keeps its derived run key; local metadata uses LANE.json's run.
    Never read the current registration to label a delayed old terminal event.
    """
    prefix = run_key(lane, "run-")
    if run.startswith(prefix) and RUN_RE.fullmatch(run[len(prefix):]):
        return run[len(prefix):]
    return run


def milestone_line(payload, kind, run, message, path):
    """Stable collector-readable local proof without changing the wire payload."""
    local, zone = payload["ts_ct"].rsplit(" ", 1)
    stamp = datetime.strptime(local, "%Y-%m-%d %H:%M:%S").replace(tzinfo=CT)
    if stamp.tzname() != zone:
        stamp = stamp.replace(fold=1)
    if stamp.tzname() != zone or not single_line(run) or any(c.isspace() for c in run):
        raise ValueError("invalid local milestone identity")
    return "%s kind=%s run=%s lane=%s %s %s" % (
        stamp.isoformat(), kind, run, payload["lane"], message, path)


def append_milestone(path, event_id, line):
    """Fsync one line under a log lock. Recover append-before-receipt crashes.

    The event marker in the log is the append commit record; a separate receipt
    cannot safely decide whether an interrupted append already happened.
    """
    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        marker = ("event_id=" + event_id).encode()
        data = (line + " event_id=" + event_id + "\n").encode("utf-8")
        tail = b""
        with os.fdopen(os.dup(fd), "rb") as stream:
            for prior in stream:
                if prior.endswith(b"\n") and prior.rstrip(b"\n").rsplit(b" ", 1)[-1] == marker:
                    os.fsync(fd)
                    return False
                tail = prior if not prior.endswith(b"\n") else b""
        if tail:
            if not data.startswith(tail):
                raise ValueError("another occurrence has an incomplete log append")
            data = data[len(tail):]
        # os.write can be short even for a regular file.
        while data:
            written = os.write(fd, data)
            if written == 0:
                raise OSError("short log write")
            data = data[written:]
        os.fsync(fd)
        parent_fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(parent_fd)
        finally:
            os.close(parent_fd)
        return True
    finally:
        os.close(fd)


def registry_lock(lanedir):
    fd = os.open(Path(lanedir) / ".LANE.lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    fcntl.flock(fd, fcntl.LOCK_EX)
    return fd


def terminal_payload(run_info):
    for sub in ("sent", "outbox"):
        path = STATE / sub / (run_info["key"] + ".json")
        if path.exists():
            return json.loads(path.read_text())
    return finish(run_info)


def terminal_log(run_info, payload):
    """Use the existing terminal payload. Never send a second terminal notice."""
    if not valid_binding(run_info.get("notice_binding"), run_info["lane"], run_info["key"], run_info["test"]):
        return
    if payload.get("outcome") != "LAUNCH_FAILED":
        record_registered_start(run_info["lane"], run_info.get("raw_run") or run_info["key"], run_info["pack"])
    event_id = payload.get("event_id") or hashlib.sha256((run_info["key"] + "/terminal").encode()).hexdigest()
    text = "terminal %s: %s" % (payload.get("outcome", "UNKNOWN"), payload.get("verdict", "UNKNOWN"))
    text = " ".join(text.split())
    path = Path(run_info["pack"]) / "LANE.json"
    raw_run = registration_run(run_info["lane"], run_info.get("raw_run") or run_info["key"])
    append_milestone(path.parent / "MILESTONES.log", event_id,
                     milestone_line(payload, "done", raw_run, text, path))


def mark_terminal(run_info, payload):
    """Only ExecStopPost marks a registered run terminal, never an agent Stop."""
    fd = registry_lock(run_info["pack"])
    try:
        path = Path(run_info["pack"]) / "LANE.json"
        registration = json.loads(path.read_text())
        raw_run = os.environ.get("SATS_RUN")
        binding = run_info.get("notice_binding")
        if (registration.get("run") != raw_run or registration.get("lane") != run_info["lane"] or
                registration.get("recipient") != (binding or {}).get("recipient")):
            return
        registration.update(status="terminal", ended_at=time.time(), outcome=payload.get("outcome", "UNKNOWN"),
                            service_result=os.environ.get("SERVICE_RESULT", "unknown"),
                            exit_code=os.environ.get("EXIT_CODE", "unknown"),
                            exit_status=os.environ.get("EXIT_STATUS", "unknown"))
        write_private(path, registration)
    finally:
        os.close(fd)


def milestone_receipt(payload, state, status, attempts, log_path, appended, disposition=None):
    return {"event_id": payload["event_id"], "state": state, "http_status": status,
            "native_delivery": "unavailable", "native_recipient_delivery": "unavailable",
            "attempts": attempts, "log_path": str(log_path), "local_appended": appended,
            "disposition": disposition or ("webhook_accepted" if state == "WEBHOOK_ACCEPTED" else "http_failed")}


def validate_milestone_fields(args):
    if not LANE_ID_RE.fullmatch(args.lane) or not all(single_line(value) for value in (
            args.run, args.message, args.occurrence, args.lanedir, args.path)) or any(
            c.isspace() for c in args.run):
        raise ValueError("invalid milestone fields")
    if args.recipient is not None and not single_line(args.recipient):
        raise ValueError("invalid milestone recipient")
    if not Path(args.lanedir).is_absolute() or not Path(args.path).is_absolute():
        raise ValueError("absolute paths required")
    if args.kind != "stalled" and not Path(args.lanedir).is_dir():
        raise ValueError("lane directory must exist")
    if args.owner_thread_id is not None and not single_line(args.owner_thread_id):
        raise ValueError("invalid owner thread")


def registered_launch_failed(run):
    """An ExecStopPost before successful exec is failure, regardless of artifacts."""
    if not run.get("unit_failed"):
        return False
    try:
        registration = json.loads((Path(run["pack"]) / "LANE.json").read_text())
    except (OSError, ValueError):
        return False
    return registration.get("start_occurrence") == "launch-start" and \
        registration.get("run") == registration_run(run["lane"], run.get("raw_run") or run["key"]) and \
        not registration.get("start_event_id")


def record_registered_start(lane, raw_run, pack):
    """Successful exec, a running driver or a native exit supplies start evidence.

    This local operation also orders the start before very short drivers' steps
    and native terminal records. Its occurrence is shared with ExecStartPost and
    the launcher, so delayed delivery never creates a second start.
    """
    path = Path(pack) / "LANE.json"
    if not path.exists():
        return None
    registration = json.loads(path.read_text())
    if registration.get("start_occurrence") != "launch-start":
        return None  # legacy registrations keep their existing terminal contract
    if registration.get("lane") != lane or registration.get("run") != registration_run(lane, raw_run):
        return None  # a delayed native exit must not record a newer run's start
    return emit_milestone(argparse.Namespace(
        lane=lane, run=registration["run"], lanedir=pack, recipient=registration["recipient"],
        kind="start", occurrence="launch-start", message="lane started", path=str(path),
        owner_thread_id=registration.get("owner_thread_id"), record_only=True))


def emit_test_milestone(args):
    """A separate local contract for historical TEST units, never a required notice."""
    validate_milestone_fields(args)
    if not (args.lane.upper().startswith("TEST") or os.environ.get("SATS_TEST") == "1") or \
            args.recipient != "TEST-local" or args.owner_thread_id or "SATS_NOTICE_BINDING" in os.environ:
        raise ValueError("isolated TEST identity required")
    if args.kind == "stalled":
        raise ValueError("TEST has no owner wake")
    lane = args.lane if args.lane.upper().startswith("TEST") else "TEST-" + args.lane
    key = hashlib.sha256(json.dumps([lane, args.run, args.kind, args.occurrence], separators=(",", ":")).encode()).hexdigest()
    ensure_state()
    directory = STATE / "test-milestones"
    directory.mkdir(mode=0o700, exist_ok=True)
    fd = os.open(directory / (key + ".lock"), os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        payload_path = directory / (key + ".json")
        if not payload_path.exists():
            write_private(payload_path, {"lane": lane, "run": args.run, "test": True, "pack": args.lanedir,
                "ts_ct": now_ct(), "event_id": key, "event_kind": args.kind, "milestone_message": args.message,
                "path": args.path, "required_notice": False, "delivery_contract": "test-local-v1"})
        payload = json.loads(payload_path.read_text())
        if payload["pack"] != args.lanedir:
            raise ValueError("immutable TEST directory mismatch")
        log_path = Path(args.lanedir) / "MILESTONES.log"
        appended = append_milestone(log_path, key, milestone_line(
            payload, args.kind, args.run, payload["milestone_message"], payload["path"]))
        return milestone_receipt(payload, "RECORDED_LOCAL", None, 0, log_path, appended, "test-local-only"), 0
    finally:
        os.close(fd)


def emit_milestone(args):
    validate_milestone_fields(args)
    if args.lane.upper().startswith("TEST") or os.environ.get("SATS_TEST") == "1":
        raise ValueError("TEST requires the separate local emitter")
    budget = getattr(args, "delivery_budget", None)
    if budget is not None and (not math.isfinite(budget) or not 0 < budget <= 30):
        raise ValueError("delivery budget must be greater than zero and at most 30 seconds")
    deadline = time.monotonic() + budget if budget is not None else None
    ensure_state()
    key_run = binding_key(args.lane, args.run)
    binding = {"lane": args.lane, "run": key_run,
               "recipient": args.recipient if args.recipient is not None else DEFAULT_NOTICE_RECIPIENT,
               "priority": True}
    inherited = os.environ.get("SATS_NOTICE_BINDING")
    if inherited is not None:
        trusted = parse_local_binding(inherited, args.lane, key_run)
        if args.recipient is not None and trusted["recipient"] != args.recipient:
            raise ValueError("launch binding mismatch")
        if args.owner_thread_id and trusted.get("owner_thread_id") != args.owner_thread_id:
            raise ValueError("owner thread mismatch")
        binding = trusted
    elif args.owner_thread_id:
        binding["owner_thread_id"] = args.owner_thread_id
    binding, enrollment = enroll_owner_binding(binding,
        preserve_existing=inherited is None and args.recipient is None and not args.owner_thread_id,
        authority="local launch binding" if inherited is not None else "local explicit CLI")
    if args.kind not in ("start", "stalled"):
        record_registered_start(args.lane, args.run, args.lanedir)
    # Recipient/step/message/path cannot create a new occurrence or retry budget.
    identity = [args.lane, key_run, args.kind, args.occurrence]
    key = hashlib.sha256(json.dumps(identity, separators=(",", ":")).encode()).hexdigest()
    directory = STATE / "milestones"
    fd = os.open(directory / (key + ".lock"), os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        payload_path = directory / (key + ".json")
        if not payload_path.exists():
            # Do not turn a claimed terminal/stall notice into a producer success.
            payload = {"lane": args.lane, "run": key_run, "raw_run": args.run, "pack": args.lanedir,
                       "host": socket.gethostname(), "agent": os.environ.get("SATS_AGENT", "script"),
                       "ts_ct": now_ct(), "test": False, "event": "milestone",
                       "outcome": args.kind.upper(), "verdict": args.message, "reason": args.kind,
                       "step": os.environ.get("SATS_STEP"), "milestone_message": args.message, "path": args.path}
            payload = required_notice(payload, args.kind, occurrence=args.occurrence, binding=binding)
            write_private(payload_path, payload)
        payload = json.loads(payload_path.read_text())
        if payload["notice_binding"] != binding or payload["pack"] != args.lanedir:
            raise ValueError("immutable occurrence binding mismatch")
        log_path = STATE / "stalled.log" if args.kind == "stalled" else Path(args.lanedir) / "MILESTONES.log"
        appended = append_milestone(log_path, payload["event_id"], milestone_line(
            payload, payload["event_kind"], registration_run(payload["lane"], payload["raw_run"]),
            payload["milestone_message"], payload["path"]))
        body = payload_path.read_bytes()
        digest = hashlib.sha256(body).hexdigest()
        proof_path = directory / (key + ".acceptance.json")
        attempts_path = directory / (key + ".attempts.jsonl")
        records = [json.loads(line) for line in attempts_path.read_text().splitlines()] if attempts_path.exists() else []
        used = sum(record.get("phase") == "reserved" for record in records)

        def result(state, status, attempts, disposition=None, code=0):
            receipt = milestone_receipt(payload, state, status, attempts, log_path, appended, disposition)
            receipt.update(local_recorded=True, delivery_exit=code, owner_enrollment=enrollment)
            receipt_path = directory / (key + ".receipt.json")
            receipt["receipt_path"] = str(receipt_path)
            write_private(receipt_path, receipt)
            return receipt, code

        if getattr(args, "record_only", False):
            if args.kind == "start" and args.occurrence == "launch-start":
                registration_path = Path(args.lanedir) / "LANE.json"
                if registration_path.exists():
                    registration_fd = registry_lock(args.lanedir)
                    try:
                        registration = json.loads(registration_path.read_text())
                        if registration.get("run") == registration_run(args.lane, args.run) and \
                                registration.get("notice_binding") == binding:
                            registration["start_event_id"] = payload["event_id"]
                            write_private(registration_path, registration)
                    finally:
                        os.close(registration_fd)
            return result("RECORDED_LOCAL", None, used, "local-record")
        if proof_path.exists():
            proof = json.loads(proof_path.read_text())
            if accepted_status(proof.get("http_status")) and proof.get("body_sha256") == digest:
                return result("WEBHOOK_ACCEPTED", proof["http_status"], used)
        if enrollment["state"] != "ENROLLED":
            return result("FAILED", None, used, "owner_enrollment_unavailable", code=1)
        last = next((record for record in reversed(records) if record.get("phase") == "result"), {})
        status = last.get("http_status")
        refreshed = False
        for number in range(used + 1, 4):
            delay = RETRY_DELAYS[number - 1]
            if deadline is not None and time.monotonic() + delay >= deadline:
                return result("FAILED", status, number - 1, "delivery-budget", code=1)
            time.sleep(delay)
            append(attempts_path, json.dumps({"phase": "reserved", "attempt": number,
                   "event_id": payload["event_id"], "body_sha256": digest}))
            # Explicit launch-authorized milestones bypass the legacy wake filter:
            # its DROP/HOLD and body merges cannot satisfy this immutable contract.
            diagnostics = {}
            url, source = None, None
            try:
                url, secret, source = webhook(cached_only=True) if deadline is not None else webhook()
                remaining = deadline - time.monotonic() if deadline is not None else None
                if remaining is not None and remaining <= 0:
                    status = None
                elif url:
                    status = _post(url, secret, body, payload["event_id"], timeout=remaining,
                                   diagnostics=diagnostics) if deadline is not None \
                        else _post(url, secret, body, payload["event_id"], diagnostics=diagnostics)
                else:
                    status = None
            except Exception:
                log_error("milestone-transport")
                status = None
                diagnostics = {"disposition": "transport_unavailable"}
            accepted = accepted_status(status)
            if accepted:
                write_private(proof_path, {"http_status": status, "body_sha256": digest})
            append(attempts_path, json.dumps({"phase": "result", "attempt": number,
                   "http_status": status, "state": "WEBHOOK_ACCEPTED" if accepted else "FAILED",
                   **diagnostics}))
            log(action="milestone-post", event_id=payload["event_id"], lane=args.lane,
                kind=args.kind, http=status, state="WEBHOOK_ACCEPTED" if accepted else "FAILED")
            if accepted:
                return result("WEBHOOK_ACCEPTED", status, number)
            if url is None:
                return result("FAILED", None, number, diagnostics.get("disposition", "deferred"), code=1)
            if deadline is None and status in (401, 403, 404) and source == "cache" and not refreshed:
                try:
                    webhook(refresh=True)
                except Exception:
                    log_error("milestone-credential-refresh")
                    return result("FAILED", status, number, "credential_refresh_unavailable", code=1)
                refreshed = True
        return result("FAILED", status, used if used >= 3 else 3, "attempt-cap-3", code=1)
    finally:
        os.close(fd)


def milestone_main(argv):
    parser = argparse.ArgumentParser(description="Append and deliver one immutable owner milestone.")
    for name in ("lane", "lanedir", "run", "message", "path", "occurrence"):
        parser.add_argument("--" + name, required=True)
    parser.add_argument("--recipient", help="defaults to the exact enrolled binding, otherwise Sats owner policy")
    parser.add_argument("--kind", required=True, choices=MILESTONE_KINDS)
    parser.add_argument("--state-dir", help="absolute private directory for isolated tests only")
    parser.add_argument("--owner-thread-id")
    parser.add_argument("--record-only", action="store_true", help="durable local record, no transport or credentials")
    parser.add_argument("--test-local", action="store_true", help="separate local-only historical TEST contract")
    parser.add_argument("--delivery-budget", type=float, help="bounded cached/loopback delivery, no credential subprocess")
    args = parser.parse_args(argv)
    try:
        if args.state_dir:
            configure_state(args.state_dir)
        receipt, code = emit_test_milestone(args) if args.test_local else emit_milestone(args)
    except Exception:
        log_error("milestone")
        receipt, code = {"event_id": None, "state": "FAILED", "http_status": None,
                         "native_delivery": "unavailable", "disposition": "local_error"}, 2
    print(json.dumps(receipt, sort_keys=True, separators=(",", ":")))
    return 0 if receipt.get("local_recorded") else code


def main():
    if sys.argv[1:2] == ["milestone"]:
        return milestone_main(sys.argv[2:])
    try:
        run(sys.argv[1:])
    except BaseException:
        try:
            ensure_state()
            log_error("hook")
        except BaseException:
            pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
